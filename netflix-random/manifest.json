{
  "manifest_version": 3,
  "name": "Netflix ランダム再生",
  "version": "1.0.0",
  "description": "気分やジャンル、再生時間からNetflixの作品をランダムにピックして、そのまま再生できます。",
  "action": {
    "default_title": "Netflix ランダム再生",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://www.netflix.com/*"]
}
